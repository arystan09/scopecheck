# Fake runs need no live-provider key. Operator bearer tokens are created by the CLI.
SCOPECHECK_MODE=fake
# For Compose, supply a freshly generated local-only password in your shell:
# export POSTGRES_PASSWORD="$(openssl rand -hex 24)"
# Never commit the generated value.
# Required for persistence/readiness only; use your generated local password.
# export SCOPECHECK_DATABASE_URL="postgresql+psycopg://scopecheck:${POSTGRES_PASSWORD}@127.0.0.1:5432/scopecheck"
# SCOPECHECK_CODE_REVISION may be set to your build's commit SHA; default: unknown.

# Optional live execution: set SCOPECHECK_OPENAI_API_KEY only in the worker
# process environment. Do not save the key here or pass it to the API service.

# Opt-in fixed fake admission; set identically for API and worker, with no key.
# SCOPECHECK_PUBLIC_DEMO=true
