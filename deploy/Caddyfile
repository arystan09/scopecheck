{
	email {$ACME_EMAIL}
	admin off
}
{$DEMO_DOMAIN} {
	# No access log: URLs, headers and credentials are not telemetry.
	@private path /metrics /metrics/*
	respond @private 404
	request_body {
		max_size 1MB
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	reverse_proxy app:8000
}
